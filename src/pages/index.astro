  src: url("/src/pages/fonts/SpotifyMix-Regular.woff2") format("woff2");
}

:root {
  --headerColor: rgb(17 85 182);
  --bodyColor: white;
  --spotifyGreen: #1db954;
}

body {
  display: flex;
  justify-content: center;
  flex-direction: column;
  font-family: "SpotifyHeaders", monospace;
  align-items: center;
  overflow-x: hidden;
  background-color: hsl(119 20.4% 78.9%);
  background-image: radial-gradient(circle, rgba(0,0,0,0.08) 1px, transparent 1px);
  background-size: 24px 24px;
  }

.input {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 1rem;
  margin-bottom: 25vh;
  }

h1 {
  color: var(--headerColor);
  font-size: clamp(1.5rem, 5.5vw, 3rem);
}

h2 {
  font-size: 1.8rem;
  color: var(--bodyColor);
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: -2em;
}

.logo img {
  width: 38px;
  height: 38px;
}

.subtitel {
  font-size: 1.6rem;
  color: var(--headerColor);
  text-align: center;
  max-width: 600px;
}

form {
  display: flex;
  flex-direction: column;
  gap: 1em;
  width: 100%;
  align-items: center;
}

.inputrow {
  display: flex;
  gap: 10px;
  align-items: flex-end;
  width: clamp(300px, 90vw, 600px);
}

textarea {
  flex: 1;
  resize: none;
  font-size: clamp(14px, 2vw, 18px);
  padding: 16px 22px;
  border: 2px solid #837e7e;
  border-radius: 28px;
  outline: none;
  caret-color: #12943f;
  background: rgba(255,255,255,0.7);
  transition: background 0.2s, border-color 0.2s;
}

textarea:focus {
  border-color: var(--spotifyGreen);
  background: white;
}

button {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: var(--spotifyGreen);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;

  &:hover {
    transform: scale(1.03);
