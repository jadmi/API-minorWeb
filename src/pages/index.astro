    transform: scale(1.05);
  }
}

.covers p {
  font-size: 1rem;
  text-align: center;
  width: 100%;
  color: var(--bodyColor);  
  margin-top: 1em;
}

</style>

<!-- Hulp van Jad -->
<script>
    // @ts-nocheck
const form = document.querySelector("form");
const textarea = document.querySelector("textarea");
const aiAnswer = document.getElementById("result");
const iconPlay = document.getElementById("iconPlay");
const iconPause = document.getElementById("iconPause");
const errorMsg = document.getElementById("errorMsg");

// Resultaten opslaan in localstorage zodat je ze blijft zien
// https://blog.logrocket.com/localstorage-javascript-complete-guide/
document.addEventListener("DOMContentLoaded", () => {
  const saved = localStorage.getItem("results");
  if (saved) {
    renderResults(JSON.parse(saved));
  }
});

function setPlaying(playing) {
  iconPlay.style.display = playing ? "none" : "block";
  iconPause.style.display = playing ? "block" : "none";
}

// Hulp van Braham - enter drukken om de input te submitten
textarea.addEventListener("keydown", (e) => {
  if (e.key === "Enter" && !e.shiftKey) {
    e.preventDefault();
    form.dispatchEvent(new Event("submit"));
    errorMsg.style.display = "none";
  }
});

function renderResults(results) {
  const resultsContainer = document.getElementById("result");
  resultsContainer.innerHTML = "";
document.querySelector(".artists").style.display = "block";
  // Resultaten visueel weergeven, artiest naam, album cover en nummer.
  results.forEach(({ artist, tracks }) => {
    const artistContainer = document.createElement("div");
    artistContainer.classList.add("artistContainer");
artistContainer.innerHTML = `
  <h2>${artist}</h2>
  <div class="covers">
    ${tracks.map(track => `
    <a href="${track.external_urls.spotify}" target="_blank">
    <img src="${track.album.images[1].url}" alt="${track.name}" />
    <p>${track.name}</p>
    </a>
`).join("")}
  </div>
`;
   resultsContainer.appendChild(artistContainer);

artistContainer.addEventListener("click", () => {
  window.location.href = `/artist/${artist}`;
});

// https://developer.mozilla.org/en-US/docs/Web/API/Event/stopPropagation
artistContainer.querySelectorAll(".covers a").forEach(link => {
  link.addEventListener("click", (e) => {
    e.stopPropagation();
  });
});
  resultsContainer.scrollIntoView({ behavior: "smooth", block: "center" });
  });
}

// Error catching wanneer je submit zonder iets in te vullen
form.addEventListener("submit", async (e) => {
  e.preventDefault();
  errorMsg.style.display = "none";
  const userInput = textarea.value;
  if (!userInput) {
    return;
  }

  setPlaying(true);

  // WebAI call, hulp van Jad 
  if ('LanguageModel' in self) {
    const session = await LanguageModel.create({
      initialPrompts: [{
        role: "system",
        content: "Je geeft drie muziek artiesten terug gebaseerd op wat de gebruiker als input geeft, alleen de artiesten namen en niks anders. Als de gebruiker een muziekartiest op geeft geef dan drie artiesten die vergelijkbare muziek hebben.  Geef exact drie artiesten terug, elke artiest gescheiden door een komma. Gebruik geen markdown of andere opmaak in je berichten. Geen markdown, geen nummering, geen extra tekst. Geen lege regels. Als je niks uit de user input kan halen en/of de opgegeven input is een naam maar geen spotify artiest zeg dan aan: Sorry hier kan ik geen artiesten uit halen, probeer wat anders!"
      }]
    });
    const result = await session.prompt(userInput);
    console.log(result);
    session.destroy();

const response = await fetch(`/api?artist=${result}&skip_groq=true`);  const data = await response.json();
  if (data.error) {
  errorMsg.textContent = "Sorry, hier kan ik geen artiesten uit halen. Probeer wat anders!";
  errorMsg.style.display = "block";
  setPlaying(false);
  return;
  }
  renderResults(data.results, true);
  localStorage.setItem("results", JSON.stringify(data.results));

  } else {

const response = await fetch(`/api?artist=${userInput}`);  
const data = await response.json();

// Error als er niks gevonden kan worden of geen input
if (data.error) {
  errorMsg.textContent = "Sorry, hier kan ik geen artiesten uit halen. Probeer wat anders!";
  errorMsg.style.display = "block";
  setPlaying(false);
  return;
}
  renderResults(data.results);
  localStorage.setItem("results", JSON.stringify(data.results));
}

setPlaying(false);


});

    
</script>





