  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  cursor: pointer;
  transition: transform 0.2s ease;

  &:hover {
    transform: scale(1.02);
  }

  &:first-of-type {
    background-color: #2e2d2d;
  }
  &:nth-of-type(2) {
